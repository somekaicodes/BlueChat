<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BlueChat.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BlueChat.Views"
    Title="BlueChat"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <ShellContent Title="Discover"
                      Icon="icon_discover.svg"
                      ContentTemplate="{DataTemplate views:DiscoverPage}"
                      Route="Discover" />

        <ShellContent Title="Chat"
                      Icon="icon_chat.svg"
                      ContentTemplate="{DataTemplate views:ChatPage}"
                      Route="Chat" />

        <ShellContent Title="Settings"
                      Icon="icon_settings.svg"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="Settings" />
    </TabBar>

</Shell>
