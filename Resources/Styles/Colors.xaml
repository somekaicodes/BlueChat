<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BlueChat brand palette — sourced from app icon -->
    <Color x:Key="Primary">#1B30A0</Color>          <!-- Deep navy background -->
    <Color x:Key="PrimaryDark">#121F6B</Color>       <!-- Darker navy for pressed states -->
    <Color x:Key="Accent">#4D92D4</Color>            <!-- Medium blue (Bluetooth icon) -->
    <Color x:Key="LightBlue">#8BAEC8</Color>         <!-- Muted light blue (received bubble) -->
    <Color x:Key="BubbleWhite">#E2DEDB</Color>       <!-- Off-white (sent bubble) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="OffBlack">#1A1A1A</Color>

    <!-- Semantic aliases -->
    <Color x:Key="PageBackground">#1B30A0</Color>
    <Color x:Key="SentBubble">#E2DEDB</Color>
    <Color x:Key="ReceivedBubble">#8BAEC8</Color>
    <Color x:Key="InputBarBackground">#162880</Color>
    <Color x:Key="NavBar">#1B30A0</Color>
    <Color x:Key="TabBar">#121F6B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource LightBlue}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>

</ResourceDictionary>
