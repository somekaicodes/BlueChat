<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BlueChat.ViewModels"
             x:Class="BlueChat.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="24">

            <!-- Device Name section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Your Device Name"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource LightBlue}"
                       TextTransform="Uppercase"
                       CharacterSpacing="1" />

                <Border BackgroundColor="#1E3DB5" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding DeviceName}"
                           Placeholder="e.g. Alice's Phone"
                           PlaceholderColor="{StaticResource LightBlue}"
                           TextColor="{StaticResource White}"
                           FontSize="17"
                           Margin="16,12"
                           ReturnCommand="{Binding SaveDeviceNameCommand}" />
                </Border>

                <Button Text="Save Name"
                        Command="{Binding SaveDeviceNameCommand}"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontAttributes="Bold" />
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" BackgroundColor="#2A45C0" Margin="0,4" />

            <!-- Discoverability section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Discoverability"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource LightBlue}"
                       TextTransform="Uppercase"
                       CharacterSpacing="1" />

                <Border BackgroundColor="#1E3DB5" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Allow others to find me"
                                   FontSize="17"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Broadcasts your device name via Bluetooth"
                                   FontSize="13"
                                   TextColor="{StaticResource LightBlue}"
                                   Opacity="0.8" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDiscoverable}"
                                OnColor="{StaticResource Accent}"
                                ThumbColor="{StaticResource White}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" BackgroundColor="#2A45C0" Margin="0,4" />

            <!-- About section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="About"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource LightBlue}"
                       TextTransform="Uppercase"
                       CharacterSpacing="1" />

                <Border BackgroundColor="#1E3DB5" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Padding="16,14" Spacing="4">
                        <Label Text="BlueChat"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Peer-to-peer messaging over Bluetooth — no internet required."
                               FontSize="14"
                               TextColor="{StaticResource LightBlue}"
                               Opacity="0.85" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
